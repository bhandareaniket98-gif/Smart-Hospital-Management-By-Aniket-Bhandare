  <!DOCTYPE html>
<html>
<head>
    <title>Smart Hospital Management</title>

    <meta name="viewport"
    content="width=device-width, initial-scale=1.0">

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background: #f0f4f8;
        }

        header {
            background: #087e8b;
            color: white;
            padding: 20px;
            text-align: center;
        }

        .container {
            padding: 15px;
        }

        .card {
            background: white;
            padding: 20px;
            margin: 15px 0;
            border-radius: 12px;
            box-shadow: 0 2px 8px #ccc;
        }

        button {
            background: #087e8b;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 7px;
            width: 100%;
        }

        h2 {
            color: #087e8b;
        }
    </style>
</head>

<body>

<header>
    <h1>🏥 Smart Hospital</h1>
    <p>Hospital Management System</p>
</header>

<div class="container">

    <div class="card">
        <h2>Welcome Admin!</h2>
        <p>Smart Hospital Management Dashboard</p>
    </div>

    <div class="card">
        <h2>👨‍⚕️ Doctor Management</h2>
        <p>Manage Hospital Doctors</p>
        <button>View Doctors</button>
    </div>

    <div class="card">
        <h2>🧑 Patient Management</h2>
        <p>Register New Patients</p>
        <button>Register Patient</button>
    </div>

    <div class="card">
        <h2>📅 Appointment</h2>
        <p>Manage Patient Appointments</p>
        <button>Book Appointment</button>
    </div>

    <div class="card">
        <h2>💳 Billing System</h2>
        <p>Manage Hospital Bills</p>
        <button>Generate Bill</button>
    </div>

</div>

</body>
</html>    